rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedEstateOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'erik@handgraafestates.com';
    }

    match /household-ops/{recordId} {
      allow read, write: if isVerifiedEstateOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
